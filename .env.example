# Run `node scripts/new-operator.mjs` to create .env.local with fresh values for
# the five variables below. Put the same values in your host's environment.

# The operator's address. It fixes the router's address (see /deploy).
NEXT_PUBLIC_OPERATOR_ADDRESS=

# The operator's key: owner, fulfiller and treasury of the router. Server only.
# It signs prices and sends every delivery, so it needs a little ETH for gas.
FULFILLER_PRIVATE_KEY=

# Encrypts card codes and e-mails before they are stored on chain.
# Losing it loses every stored code.
CARDS_SECRET=

# Protects /api/cron/renew (auto-pay). Sent as "Authorization: Bearer …".
CRON_SECRET=

# The password of /admin, where orders are delivered by hand.
ADMIN_SECRET=

# Optional: your own RPC for Robinhood Chain (server side only).
ROBINHOOD_RPC_URL=

# Optional: use an already deployed router instead of the computed one (local fork).
NEXT_PUBLIC_ROUTER_ADDRESS=

# --- optional: automatic gift card supplier (Reloadly) -----------------------
# Without it every order is delivered by hand from /admin.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true
# Our brand id -> Reloadly productId, e.g. {"netflix":1234,"spotify":5678}
RELOADLY_PRODUCTS={}
RELOADLY_SENDER_NAME=Covered
